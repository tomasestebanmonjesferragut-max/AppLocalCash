<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/Ayuda"
        android:layout_marginBottom="8dp"
        android:text="Egreso = gastaste dinero. Ingreso = recibiste dinero. El saldo de la cuenta se actualiza solo." />

    <TextView
        style="@style/TituloSeccion"
        android:text="Cuenta" />

    <Spinner
        android:id="@+id/spCuenta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        style="@style/TituloSeccion"
        android:layout_marginTop="8dp"
        android:text="Tipo" />

    <RadioGroup
        android:id="@+id/rgTipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbEgreso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/rojo"
            android:checked="true"
            android:text="➖ Egreso\n(resta)"
            android:textColor="@color/rojo"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/rbIngreso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/verde"
            android:text="➕ Ingreso\n(suma)"
            android:textColor="@color/verde_oscuro"
            android:textStyle="bold" />
    </RadioGroup>

    <EditText
        android:id="@+id/txtMonto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Monto $"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/txtDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Descripción (ej: almuerzo, sueldo)" />

</LinearLayout>
