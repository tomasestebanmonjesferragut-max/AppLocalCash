<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/Ayuda"
        android:layout_marginBottom="8dp"
        android:text="Egreso = gastaste dinero. Ingreso = recibiste dinero. El saldo de la cuenta se actualiza solo." />

    <TextView
        style="@style/TituloSeccion"
        android:text="Cuenta" />

    <Spinner
        android:id="@+id/spCuenta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        style="@style/TituloSeccion"
        android:layout_marginTop="8dp"
        android:text="Tipo" />

    <RadioGroup
        android:id="@+id/rgTipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbEgreso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/rojo"
            android:checked="true"
            android:text="➖ Egreso\n(resta)"
            android:textColor="@color/rojo"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/rbIngreso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/verde"
            android:text="➕ Ingreso\n(suma)"
            android:textColor="@color/verde_oscuro"
            android:textStyle="bold" />
    </RadioGroup>

    <EditText
        android:id="@+id/txtMonto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Monto $"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/txtDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Descripción (ej: almuerzo, sueldo)" />

    <TextView
        style="@style/TituloSeccion"
        android:layout_marginTop="8dp"
        android:text="📍 Ubicación (opcional)" />

    <!-- Desde el panel: usar el GPS o ir al mapa a elegir el lugar -->
    <LinearLayout
        android:id="@+id/panelUbicacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <CheckBox
            android:id="@+id/chkUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usar mi ubicación actual" />

        <Button
            android:id="@+id/btnElegirMapa"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗺️ Elegir el lugar en el mapa" />
    </LinearLayout>

    <!-- Desde el mapa: el lugar ya esta elegido -->
    <TextView
        android:id="@+id/txtUbicacionMapa"
        style="@style/Ayuda"
        android:text="Se guarda en el punto que mantuviste presionado en el mapa."
        android:visibility="gone" />

</LinearLayout>
