<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".MapaActivity">

    <LinearLayout
        android:id="@+id/encabezado"
        style="@style/Encabezado"
        android:layout_alignParentTop="true"
        android:layout_margin="8dp">

        <TextView
            android:id="@+id/txtTituloMapa"
            style="@style/EncabezadoTitulo"
            android:text="🗺️ Mapa de movimientos" />

        <TextView
            android:id="@+id/txtAyudaMapa"
            style="@style/EncabezadoTexto"
            android:text="Toca el mapa para marcar un lugar y registrar un gasto o ingreso ahí." />

        <TextView
            style="@style/EncabezadoTexto"
            android:layout_marginTop="8dp"
            android:text="🟢 Ingreso (+)   🔴 Egreso (−)   🔵 Tú   🟡 Marcado"
            android:textColor="@color/white" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/botones"
        android:layout_below="@id/encabezado" />

    <LinearLayout
        android:id="@+id/botones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="8dp"
        android:orientation="vertical">

        <!-- Aparece cuando hay un punto marcado -->
        <Button
            android:id="@+id/btnAccionPunto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="➕ Registrar movimiento aquí"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnVolver"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⬅  Volver al panel" />
    </LinearLayout>

</RelativeLayout>
