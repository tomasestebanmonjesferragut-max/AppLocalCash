<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".MapaActivity">

    <LinearLayout
        android:id="@+id/encabezado"
        style="@style/Encabezado"
        android:layout_alignParentTop="true"
        android:layout_margin="8dp">

        <TextView
            style="@style/EncabezadoTitulo"
            android:text="🗺️ Mapa de movimientos" />

        <TextView
            style="@style/EncabezadoTexto"
            android:text="Mantén presionado el mapa para registrar un gasto o ingreso en ese lugar." />

        <TextView
            style="@style/EncabezadoTexto"
            android:layout_marginTop="8dp"
            android:text="🟢 Ingreso (+)   🔴 Egreso (−)   🔵 Tú   🟡 Marcado"
            android:textColor="@color/white" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btnVolver"
        android:layout_below="@id/encabezado" />

    <Button
        android:id="@+id/btnVolver"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="8dp"
        android:text="⬅  Volver al panel" />

</RelativeLayout>
