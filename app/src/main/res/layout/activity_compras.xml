<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout style="@style/Encabezado">

        <TextView
            style="@style/EncabezadoTitulo"
            android:text="🛒 Compras" />

        <TextView
            style="@style/EncabezadoTexto"
            android:text="Registra lo que compraste o agenda compras futuras para saber cuánto dinero apartar." />
    </LinearLayout>

    <LinearLayout style="@style/Tarjeta">

        <TextView
            style="@style/TituloSeccion"
            android:text="Nueva compra" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Campo"
            android:hint="Qué compraste o vas a comprar">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Campo"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="Monto"
                app:prefixText="$ ">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtMonto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Campo"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="Fecha (15-10-2026)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="date" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <CheckBox
            android:id="@+id/chkAgendada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📅 Agendar (compra futura)" />

        <TextView
            style="@style/Ayuda"
            android:layout_marginTop="4dp"
            android:text="Compartir con (opcional)" />

        <Spinner
            android:id="@+id/spContacto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_campo"
            android:paddingHorizontal="8dp" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="💾 Guardar compra" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtTotalAgendado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_tarjeta"
        android:backgroundTint="@color/verde_claro"
        android:padding="12dp"
        android:textColor="@color/verde_oscuro"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/TituloSeccion"
            android:text="Historial" />

        <TextView
            style="@style/Ayuda"
            android:text="Toca una compra para marcarla como realizada o borrarla." />

        <ListView
            android:id="@+id/lista"
            style="@style/Lista" />
    </LinearLayout>

</LinearLayout>
