<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:layout_margin="16dp">

    <LinearLayout style="@style/Encabezado">

        <TextView
            style="@style/EncabezadoTitulo"
            android:text="👥 Contactos" />

        <TextView
            style="@style/EncabezadoTexto"
            android:text="Tu agenda: cada contacto con su número y cuánto te debe, sumando sus gastos compartidos." />
    </LinearLayout>

    <LinearLayout style="@style/Tarjeta">

        <TextView
            style="@style/TituloSeccion"
            android:text="Nuevo contacto" />

        <EditText
            android:id="@+id/txtNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/txtTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Número (ej: 912345678)"
            android:inputType="phone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/txtMeDebe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="¿Te debe? $ (opcional)"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/txtMotivo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="Motivo (opcional)" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAgregar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar contacto" />
    </LinearLayout>

    <LinearLayout
        style="@style/Tarjeta"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            style="@style/TituloSeccion"
            android:text="Tu agenda" />

        <TextView
            style="@style/Ayuda"
            android:text="Toca un contacto para llamarlo, anotar lo que te debe o marcar pagos." />

        <ListView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

</LinearLayout>
